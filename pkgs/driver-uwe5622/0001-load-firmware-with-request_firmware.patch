Load firmware and board config through request_firmware()

The driver read wcnmodem.bin and the wifi board .ini with filp_open() from
hardcoded /lib/firmware paths. That bypasses the kernel firmware loader, so
it breaks on distributions with another firmware directory (NixOS) or with
compressed firmware. Use request_firmware() with the file name instead.

--- a/unisocwcn/platform/wcn_boot.c
+++ b/unisocwcn/platform/wcn_boot.c
@@ -922,61 +922,43 @@
 	return NULL;
 }
 
+/*
+ * Read [offset, offset + imag_size) of a firmware image through the kernel
+ * firmware loader. Only the file name of @path is used: the loader searches
+ * the configured firmware directories and handles compressed files, so the
+ * image does not have to live at a hardcoded /lib/firmware path.
+ */
 static char *load_firmware_data_path(const char *path, loff_t offset,
 	unsigned long int imag_size)
 {
-	int read_len, size, i, opn_num_max = 1;
-	char *buffer = NULL;
-	char *data = NULL;
-	struct file *file;
+	const struct firmware *fw;
+	const char *name = kbasename(path);
+	char *buffer;
+	size_t len = 0;
+	int ret;
 
 	WCN_DEBUG("%s Enter\n", __func__);
-	file = wcn_filp_open(path, O_RDONLY, 0);
-	for (i = 1; i <= opn_num_max; i++) {
-		if (IS_ERR(file)) {
-			WCN_DEBUG("%s: try open file %s,count_num:%d\n",
-				  __func__, path, i);
-			ssleep(1);
-			file = wcn_filp_open(path, O_RDONLY, 0);
-		} else
-			break;
-	}
-	if (IS_ERR(file)) {
-		WCN_ERR("%s: open file %s error\n",
-			__func__, path);
+	ret = request_firmware(&fw, name, NULL);
+	if (ret) {
+		WCN_ERR("%s: request_firmware %s error %d\n",
+			__func__, name, ret);
 		return NULL;
 	}
-	WCN_DEBUG("marlin %s open image file sucessfully\n",
-		  __func__);
-	size = imag_size;
-	buffer = vmalloc(size);
+
+	buffer = vzalloc(imag_size);
 	if (!buffer) {
-		fput(file);
+		release_firmware(fw);
 		WCN_ERR("no memory for image\n");
 		return NULL;
 	}
 
-	data = buffer;
-	do {
-#if KERNEL_VERSION(4, 14, 0) <= LINUX_VERSION_CODE
-		read_len = kernel_read(file, (void *)buffer, size, &offset);
-#else
-		read_len = kernel_read(file, offset, buffer, size);
-#endif
-		if (read_len > 0) {
-			size -= read_len;
-			buffer += read_len;
-		}
-	} while ((read_len > 0) && (size > 0));
-	fput(file);
-	WCN_DEBUG("%s finish read_Len:%d\n", __func__, read_len);
-#if KERNEL_VERSION(4, 14, 0) > LINUX_VERSION_CODE
-	/* kernel_read return value changed. */
-	if (read_len <= 0)
-		return NULL;
-#endif
+	if (offset < fw->size)
+		len = min_t(size_t, imag_size, fw->size - offset);
+	memcpy(buffer, fw->data + offset, len);
+	release_firmware(fw);
+	WCN_DEBUG("%s finish read_Len:%zu\n", __func__, len);
 
-	return data;
+	return buffer;
 }
 
